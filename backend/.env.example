PORT=5000

# MySQL (XAMPP / WAMP / MySQL Workbench default: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serenity_grand_hotel

# Allowed frontend origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret key the admin panel must send in the "x-admin-key" header for admin-only routes
ADMIN_API_KEY=change-this-to-a-long-random-string
